BREVO_SMTP_KEY=
BREVO_API_KEY=
BREVO_SMTP_LOGIN=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Swip Sales

CV_BUCKET=candidate-cvs
MAX_CV_UPLOAD_MB=8

# Delai maximal des appels au fournisseur IA Anthropic.
ANTHROPIC_TIMEOUT_MS=30000
# "*" autorise tous les candidats. Sinon, liste de plans separes par des virgules.
AI_CV_ACCESS_PLANS=*
AI_COACH_ACCESS_PLANS=*

# Quotas mensuels candidat (compteurs d'usage, distincts des rate-limits par minute).
AI_QUOTA_CARRIERE_CV=30
AI_QUOTA_CARRIERE_COACH=0
AI_QUOTA_CARRIERE_COACHING_CV=50
AI_QUOTA_CARRIERE_COACHING_COACH=100
# Tarifs de monitoring uniquement : USD par million de tokens et conversion estimative.
AI_INPUT_USD_PER_MTOK=3
AI_OUTPUT_USD_PER_MTOK=15
AI_USD_TO_EUR=0.92
AI_COACH_HISTORY_MAX_CHARS=24000
