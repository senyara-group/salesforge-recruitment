PASSWORD_RESET_REDIRECT_URL=https://www.swipsales.fr/swipsales_reset.html

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
