STRIPE_PRICE_CANDIDAT_PREMIUM_MONTH=
STRIPE_PRICE_CANDIDAT_GOLD_MONTH=
STRIPE_PRICE_CANDIDAT_PLATINE_MONTH=
STRIPE_PRICE_CANDIDAT_PREMIUM_YEAR=
STRIPE_PRICE_CANDIDAT_GOLD_YEAR=
STRIPE_PRICE_CANDIDAT_PLATINE_YEAR=
STRIPE_PRICE_RECRUTEUR_STARTER_MONTH=
STRIPE_PRICE_RECRUTEUR_PRO_MONTH=
STRIPE_PRICE_RECRUTEUR_ENTERPRISE_MONTH=
STRIPE_PRICE_RECRUTEUR_STARTER_YEAR=
STRIPE_PRICE_RECRUTEUR_PRO_YEAR=
STRIPE_PRICE_RECRUTEUR_ENTERPRISE_YEAR=

ANTHROPIC_API_KEY=
